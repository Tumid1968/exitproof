{
  "name": "exitproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeFi dependency & exit-liquidity risk engine for MetaMorpho V1 vaults, proven on a frozen-block local fork",
  "license": "MIT",
  "scripts": {
    "proxy": "tsx src/proxy/rpcProxy.ts online",
    "proxy:offline": "tsx src/proxy/rpcProxy.ts offline",
    "fork": "hardhat node --fork http://127.0.0.1:8600 --fork-block-number 26157638",
    "discover": "tsx src/cli/discover.ts",
    "phase0": "tsx src/cli/phase0.ts",
    "scenarios": "tsx src/cli/run.ts",
    "build:report": "tsx src/cli/build.ts",
    "replay": "tsx src/cli/replay.ts",
    "typecheck": "tsc --noEmit",
    "api": "tsx src/server/server.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "test": "node --import tsx --test test/unit.test.ts test/analytic.test.ts",
    "test:fork": "node --import tsx --test --test-concurrency=1 test/acceptance.test.ts",
    "all": "tsx src/cli/all.ts",
    "export:static": "tsx src/cli/export-static.ts",
    "build:static": "tsx src/cli/export-static.ts && vite build --config web/vite.config.ts",
    "demo": "tsx src/cli/demo.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 --test-reporter=spec test/e2e/site.e2e.ts",
    "test:e2e:url": "node -e \"if(!process.env.E2E_URL){console.error('set E2E_URL');process.exit(1)}\" && node --import tsx --test --test-concurrency=1 --test-reporter=spec test/e2e/site.e2e.ts",
    "history": "tsx src/cli/history.ts",
    "refine": "tsx src/cli/refine.ts"
  },
  "dependencies": {
    "hardhat": "3.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@fontsource/outfit": "5.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
